{
  "manifest_version": 3,
  "name": "Device Tracker Monitor",
  "version": "1.0.0",
  "description": "Monitor your devices from Google Find My Device",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*android/find*",
    "*://findmydevice.google.com/*",
    "*://android.google.com/find*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*android/find*",
        "*://findmydevice.google.com/*",
        "*://android.google.com/find*"
      ],
      "js": ["visibility-override.js", "network-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*/*android/find*",
        "*://findmydevice.google.com/*",
        "*://android.google.com/find*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*.vercel.app/*"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
